import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int a = s.nextInt();
        int b = a;

        while (b < 100) {
            System.out.print(b + " ");
            if (b % 10 == 0) {
                break;
            }
            b += a;
        }

        s.close();
    }
