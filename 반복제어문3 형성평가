import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int a = 0;
        int b = 0;

        for (int i = 0; i < 20; i++) {
            int c = s.nextInt();
            if (c == 0) {
                break;
            }
            a += c;
            b++;
        }

        int d = 0;
        if (b > 0) {
            d = a / b;
        }

        System.out.println(a + " " + d);

        s.close();
    }
}

