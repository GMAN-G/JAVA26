import java.util.Scanner;

public class Main {
    public static void main (String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int[][] a = new int[n][n];

        for (int b = 0; b < n; b++) {
            for (int c = 0; c <= b; c++)
                if (c == 0) {
                    a[b][0] = 1;
                }
                else {
                    a[b][c] = a[b-1][c] + a[b-1][c-1];
                }
        }

        for (int b = n - 1; b >= 0; b--) {
            for (int c = 0; c <= b; c++) {
                System.out.print(a[b][c] + " ");
            }
            System.out.println();
        }
    }
}

