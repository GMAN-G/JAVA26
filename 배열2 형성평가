import java.util.Scanner;

public class Main {
    public static void main (String[] args) {
        Scanner s = new Scanner(System.in);
        int[] a = new int[10];
        int c = 0;

        while (true) {
            int b = s.nextInt();

            if (b < 10) {
                a[c] = b;
                c++;
                if (c == 2) {
                    break;
                }
            }
            else {
                continue;
            }
        }

        for (int d = 2; d < 10; d++) {
            a[d] = (a[d-2] + a[d-1]) % 10;
        }

        for (int d = 0; d < 10; d++) {
            System.out.print(a[d] + " ");
        }

        s.close();
    }
}

