import java.util.Scanner;

public class Main {
    public static void main (String[] args) {
        Scanner s = new Scanner(System.in);
        int[] a = new int[11];

        while (true) {
            int b = s.nextInt();

            if (b == 0) {
                break;
            }
            
            int e = b / 10;
            a[e]++;
        }

        for (int d = 10; d >= 0; d--) {
            if (a[d] > 0) {
                System.out.printf("%d : %d person\n", d * 10, a[d]);
            }
        }

        s.close();
    }
}

