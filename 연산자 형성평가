import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int a = s.nextInt();
        int b = s.nextInt();
        
        a = a + 5;
        b = b * 2;

        System.out.printf("width = %d\n", a);
        System.out.printf("length = %d\n", b);
        System.out.printf("area = %d\n", a * b);

        s.close();
    }
}

