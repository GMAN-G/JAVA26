import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int a = s.nextInt();
        int b = s.nextInt();
        int c = s.nextInt();
        int d = s.nextInt();

        System.out.printf("sum %d\n", a + b + c + d);
        System.out.printf("avg %d\n", (a + b + c + d) / 4);

        s.close();
    }
}

