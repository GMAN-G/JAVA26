import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int[] a = new int[100];
        int c = 0;

        while (true) {
            int b = s.nextInt();

            if (b == -1) {
                break;
            }

            a[c] = b;
            c++;
        }

        if (c >= 3) {
            System.out.print(a[c - 3] + " " + a[c - 2] + " " + a[c - 1]);
        }

        else {
            for (int d = 0; d < c; d++) {
                System.out.print(a[d] + " ");
            }
        }

        s.close();
    }
}

