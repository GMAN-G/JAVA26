import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int[] a = new int[100];
        int c = 0;

        while (true) {
            int b = s.nextInt();
            
            if (b < 1000 && b != 999) {
                a[c] = b;
                c++;
            
            }
            else if (b == 999) {
                break;
            }
        }

        int d = a[0];
        int e = a[0];

        for (int f = 1; f < c; f++) {
            if (a[f] > d) {
                d = a[f];
            }
            else if (a[f] < e) {
                e = a[f];
            }
        }

        System.out.printf("max : %d\nmin : %d", d, e);

        s.close();
    }
}

