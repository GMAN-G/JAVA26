import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int[] a = new int[10];
        int c = 0; 
        int d = 0;


        for (int b = 0; b < 10; b++) {
            a[b] = s.nextInt();
        }

        for (int b = 0; b < 10; b++) {
            if (b % 2 == 0) {
                c = c + a[b];
            }
        }

        for (int b = 0; b < 10; b++) {
            if (b % 2 == 1) {
                d = d + a[b];
            }
        }

        System.out.printf("odd : %d\neven : %d", c, d);

        s.close();
    }
}

