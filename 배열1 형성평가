import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int d = 0;
        int e = 0;

        while (true) {
            int b = s.nextInt();
            
            if (b == 0) {
                break;
            }
            else if (b % 5 == 0) {
                d++;
                e = e + b;
            }
            else {
                continue;
            }
        }

        double f = (double) e / d;

        System.out.printf("Multiples of 5 : %d\nsum : %d\navg : %.1f", d, e, f);

        s.close();
    }
}

