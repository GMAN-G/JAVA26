import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        
        int[] a = new int[100];
        int c = 0;

        while (true) {
            int b = s.nextInt();

            if (b == 0) {
                break;
            }
            else {
                a[c] = b;
                c++;
            }
        }

        System.out.println(c);

        for (int d = 0; d < c; d++) {
            
            
            if (a[d] % 2 == 1 || a[d] % 2 == -1) { 
                System.out.print((a[d] * 2) + " ");
            }
            
            else if (a[d] % 2 == 0) { 
                System.out.print((a[d] / 2) + " ");
            }
        }

        s.close();
    }
}
