import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        
        int odd = 0;
        int even = 0;

        while (true) {
            int num = s.nextInt();
            if (num == 0) {
                break;
            }
            if (num % 2 == 0) {
                even++;
            } 
            else {
                odd++;
            }
        }

        System.out.println("odd : " + odd);
        System.out.println("even : " + even);

        s.close();
    }
}

