import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int count = 0;

        while (true) {
            int num = s.nextInt();

            if (num == 0) {
                break;
            }

            if (num % 3 != 0 && num % 5 != 0) {
                count++;
            }
        }

        System.out.println(count);
        
        s.close();
    }
}
