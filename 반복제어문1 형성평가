import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int sum = 0;
        int count = 0;

        while (true) {
            int num = s.nextInt();
            
            if (num < 0 || num > 100) {
                break;
            }
            sum += num;
            count++;
        }

        double average = count == 0 ? 0.0 : (double) sum / count;

        System.out.println("sum : " + sum);
        System.out.printf("avg : %.1f\n", average);

        s.close();
    }
}

