import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int evenCount = 0;
        int oddCount = 0;

        for (int i = 0; i < 10; i++) {
            int num = s.nextInt();
            if (num % 2 == 0) {
                evenCount++;
            } 
            else {
                oddCount++;
            }
        }

        System.out.println("even : " + evenCount);
        System.out.println("odd : " + oddCount);

        s.close();
    }
}

