import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int a = s.nextInt();
        int b = s.nextInt();
        
        int min;
        int max;
        if (a < b) {
            min = a;
            max = b;
        } 
        else {
            min = b;
            max = a;
        }

        int sum = 0;
        int count = 0;
        for (int i = min; i <= max; i++) {
            if (i % 3 == 0 || i % 5 == 0) {
                sum += i;
                count++;
            }
        }

        double average = 0.0;
        if (count > 0) {
            average = (double) sum / count;
        }

        System.out.println("sum : " + sum);
        System.out.printf("avg : %.1f\n", average);

        s.close();
    }
}

